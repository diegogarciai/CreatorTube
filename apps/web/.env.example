# Copia este archivo como .env.local y llena los valores.

# URL pública de la app (sin barra final). En Vercel: https://tu-dominio.com
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API). Con `supabase start` los imprime la CLI.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección autorizada: {APP_URL}/api/youtube/callback
# APIs habilitadas: YouTube Data API v3 y YouTube Analytics API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave para cifrar los tokens de Google (32 bytes en base64). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guárdala fuera de la base de datos (variables de entorno de Vercel). Si cambia,
# los canales tendrán que reconectarse.
TOKEN_ENCRYPTION_KEY=

# Secreto que Vercel Cron envía como "Authorization: Bearer ..." a /api/cron/*.
CRON_SECRET=

# Trigger.dev (motor de tareas largas): Project → API keys → clave secreta del
# entorno Production (tr_prod_…). Ver docs/configurar-trigger.md.
TRIGGER_SECRET_KEY=
