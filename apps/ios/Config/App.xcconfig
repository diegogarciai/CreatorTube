// Ajustes comunes. Los secretos van en Secrets.xcconfig (no se versiona);
// si no existe, la app compila y muestra "Falta configurar Supabase".
SUPABASE_URL =
SUPABASE_ANON_KEY =

// Dirección de la web (enlaces de invitación, calendario ICS y, más adelante,
// las funciones de IA). Se puede cambiar en Secrets.xcconfig.
WEB_URL = https:/$()/app.gartechs.com

// Equipo de Apple para firmar en un iPhone. Va en Secrets.xcconfig para que
// no se pierda al regenerar el proyecto con xcodegen.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Secrets.xcconfig"
