// Copia este archivo como Secrets.xcconfig (mismo directorio) y rellénalo con
// los valores de Supabase → Project Settings → API. Son los mismos que
// NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY de la web.
//
// Ojo: en .xcconfig "//" empieza un comentario, por eso la URL se escribe con
// "/$()/" en lugar de "//".
SUPABASE_URL = https:/$()/TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY = tu-clave-anon

// Para instalar en tu iPhone: el Team ID de 10 caracteres que aparece en
// developer.apple.com/account → Membership details (o en Xcode, Signing).
DEVELOPMENT_TEAM =

// Nunca pongas aquí la clave service_role.
