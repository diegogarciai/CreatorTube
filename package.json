{
  "name": "planificador",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "pnpm --filter @planificador/db test:rls",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
